diff -ruN /mnt/data/vm-pristine/VirtualMacOniPad-main/VirtualMac/vz/host/VMRootPaths.m /mnt/data/VirtualMacOniPad-RootHide-Port/VirtualMacOniPad-main/VirtualMac/vz/host/VMRootPaths.m
