@@ -0,0 +1,51 @@
+#import "VMRootPaths.h"
+#include <limits.h>
+#include <stdio.h>
+
+#if defined(VM_ROOTHIDE)
+extern const char *jbroot(const char *path);
+#endif
+
+NSString *VMJailbreakRootPath(void)
+{
+#if defined(VM_ROOTHIDE)
+    const char *root = jbroot("/");
+    return root ? [NSString stringWithUTF8String:root] : @"/";
+#else
+    return @"/var/jb";
+#endif
+}
+
+NSString *VMRuntimeRootPath(void)
+{
+#if defined(VM_ROOTHIDE)
+    const char *path = jbroot("/User/Library/VirtualMac");
+    return path ? [NSString stringWithUTF8String:path]
+                : [VMJailbreakRootPath() stringByAppendingPathComponent:@"User/Library/VirtualMac"];
+#else
+    return @"/var/root/VirtualMac";
+#endif
+}
+
+const char *VMRuntimeRootCString(void)
+{
+    return VMRuntimeRootPath().fileSystemRepresentation;
+}
+
+const char *VMJailbreakRootCString(void)
+{
+    return VMJailbreakRootPath().fileSystemRepresentation;
+}
+
+const char *VMRuntimePathCString(const char *relativePath)
+{
+    static __thread char path[PATH_MAX];
+    const char *root = VMRuntimeRootCString();
+    if (!relativePath || !relativePath[0]) {
+        snprintf(path, sizeof(path), "%s", root);
+    } else {
+        while (*relativePath == '/') relativePath++;
+        snprintf(path, sizeof(path), "%s/%s", root, relativePath);
+    }
+    return path;
+}
