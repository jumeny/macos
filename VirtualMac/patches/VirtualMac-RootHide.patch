@@ -0,0 +1,148 @@
+#!/bin/bash
+set -euo pipefail
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+source "$SCRIPT_DIR/lib/common.sh"
+
+need_command dpkg-deb
+need_command plutil
+need_command rsync
+need_command xattr
+
+export VZ_ROOTHIDE=1
+export VZ_SKIP_REBUILD="${VZ_SKIP_REBUILD:-0}"
+if [[ "$VZ_SKIP_REBUILD" != 1 ]]; then
+    "$SCRIPT_DIR/build-ipad-vm.sh"
+    "$SCRIPT_DIR/build-ipad-network-helpers.sh"
+    "$SCRIPT_DIR/build-ipad-network-sharing.sh"
+    "$SCRIPT_DIR/build-ipad-installation.sh"
+    "$SCRIPT_DIR/build-ipad-app.sh"
+    "$SCRIPT_DIR/build-springboard-tweak.sh"
+fi
+
+commit_count="$(git -C "$VZ_REPO_ROOT" rev-list --count HEAD)"
+commit_hash="$(git -C "$VZ_REPO_ROOT" rev-parse --short=10 HEAD)"
+release_version="${VZ_RELEASE_VERSION:-1.2.3}"
+version="2:${release_version}+${commit_count}.${commit_hash}.roothide"
+release="$VZ_BUILD_ROOT/release-roothide"
+stage="$(mktemp -d -t VirtualMac-roothide.XXXXXX)"
+trap 'rm -rf "$stage"' EXIT
+chmod 755 "$stage"
+
+# RootHide package paths are relative to jbroot. Keep the large runtime under
+# User/Library as requested; only the application bundle remains in Applications
+# because SpringBoard/uicache expects a conventional app bundle location.
+mkdir -p "$stage/DEBIAN" \
+    "$stage/User/Library/VirtualMac" \
+    "$stage/Applications" \
+    "$stage/usr/lib/TweakInject" \
+    "$release"
+
+runtime="$stage/User/Library/VirtualMac"
+
+ditto "$VZ_BUILD_ROOT/ipad-installation/payload" "$runtime/payload"
+# Authoritative VM runtime overlays installation's cached compatibility payload.
+ditto "$VZ_BUILD_ROOT/ipad-vm/payload" "$runtime/payload"
+ditto "$VZ_BUILD_ROOT/ipad-installation/install" "$runtime/install"
+
+ditto "$VZ_BUILD_ROOT/ipad-app/VirtualMac.app" "$stage/Applications/VirtualMac.app"
+
+# Keep the tweak outside the private runtime because RootHide's tweak loader
+# discovers TweakInject as a bootstrap component.
+install -m 755 "$VZ_BUILD_ROOT/ipad-tweak/VZKeyboardPassthrough.dylib" \
+    "$stage/usr/lib/TweakInject/VZKeyboardPassthrough.dylib"
+install -m 644 "$VZ_BUILD_ROOT/ipad-tweak/VZKeyboardPassthrough.plist" \
+    "$stage/usr/lib/TweakInject/VZKeyboardPassthrough.plist"
+
+# Runtime data that belongs to the package, but not the VM bundles themselves.
+install -d "$runtime/Diagnostics" "$runtime/Installations" "$runtime/Restore Images"
+
+cat > "$stage/DEBIAN/control" <<CONTROL
+Package: com.mac.virtual.roothide
+Name: Virtual Mac (RootHide)
+Version: $version
+Architecture: iphoneos-arm64e
+Description: Virtual Mac on iPad with RootHide packaging.
+Maintainer: Virtual Mac
+Author: Virtual Mac
+Section: Utilities
+Priority: optional
+Depends: firmware (>= $VZ_IPADOS_MIN_VERSION), firmware (<< 16.4), ellekit
+Tag: role::enduser
+CONTROL
+
+cat > "$stage/DEBIAN/postinst" <<'POSTINST'
+#!/bin/sh
+set -eu
+export PATH=/usr/bin:/bin:/usr/sbin:/sbin
+runtime=/User/Library/VirtualMac
+app=/Applications/VirtualMac.app
+
+# RootHide bootstrap commands use jbroot as their root. No /var/jb paths are
+# used here. VM bundles remain in /var/mobile/Media/VirtualMac.
+mkdir -p "$runtime" /usr/lib/TweakInject
+chmod 755 "$runtime" "$runtime/install" "$runtime/payload" 2>/dev/null || true
+chmod 755 "$runtime/install/install-launcher" 2>/dev/null || true
+
+# Select the host-ABI variants exactly as the legacy package does.
+host_version="$(sw_vers -productVersion)"
+vmm_dir="$runtime/payload/VirtualMachine.xpc/Contents/MacOS"
+vmm_variant="$vmm_dir/com.apple.Virtualization.VirtualMachine.ipados16"
+case "$host_version" in
+  14.*) vmm_variant="$vmm_dir/com.apple.Virtualization.VirtualMachine.ipados14";;
+  15.*) vmm_variant="$vmm_dir/com.apple.Virtualization.VirtualMachine.ipados15";;
+esac
+cp "$vmm_variant" "$vmm_dir/com.apple.Virtualization.VirtualMachine.new"
+chmod 755 "$vmm_dir/com.apple.Virtualization.VirtualMachine.new"
+mv -f "$vmm_dir/com.apple.Virtualization.VirtualMachine.new" "$vmm_dir/com.apple.Virtualization.VirtualMachine"
+
+install_variant="$runtime/payload/Installation.xpc/Contents/MacOS/com.apple.Virtualization.Installation.ipados16"
+case "$host_version" in
+  14.*) install_variant="$runtime/payload/Installation.xpc/Contents/MacOS/com.apple.Virtualization.Installation.ipados14";;
+  15.*) install_variant="$runtime/payload/Installation.xpc/Contents/MacOS/com.apple.Virtualization.Installation.ipados15";;
+esac
+cp "$install_variant" "$runtime/payload/Installation.xpc/Contents/MacOS/com.apple.Virtualization.Installation.new"
+chmod 755 "$runtime/payload/Installation.xpc/Contents/MacOS/com.apple.Virtualization.Installation.new"
+mv -f "$runtime/payload/Installation.xpc/Contents/MacOS/com.apple.Virtualization.Installation.new" "$runtime/payload/Installation.xpc/Contents/MacOS/com.apple.Virtualization.Installation"
+
+# Register the app after its bundle is present. uicache is supplied by the
+# RootHide bootstrap.
+if command -v uicache >/dev/null 2>&1; then
+    uicache -p "$app" >/dev/null 2>&1 || uicache -i com.mac.virtual >/dev/null 2>&1 || true
+fi
+
+echo "Virtual Mac RootHide package installed. Runtime: $runtime"
+POSTINST
+chmod 755 "$stage/DEBIAN/postinst"
+
+cat > "$stage/DEBIAN/prerm" <<'PRERM'
+#!/bin/sh
+set -eu
+export PATH=/usr/bin:/bin:/usr/sbin:/sbin
+killall VirtualMac 2>/dev/null || true
+killall com.apple.Virtualization.VirtualMachine 2>/dev/null || true
+killall com.apple.Virtualization.Installation 2>/dev/null || true
+uicache -u /Applications/VirtualMac.app 2>/dev/null || true
+PRERM
+chmod 755 "$stage/DEBIAN/prerm"
+
+cat > "$stage/DEBIAN/postrm" <<'POSTRM'
+#!/bin/sh
+set -eu
+# Keep user-created VM bundles in /var/mobile/Media/VirtualMac. dpkg owns the
+# runtime under User/Library/VirtualMac and removes it normally.
+if [ "${1:-}" = remove ] || [ "${1:-}" = purge ]; then
+    uicache -a >/dev/null 2>&1 || true
+fi
+POSTRM
+chmod 755 "$stage/DEBIAN/postrm"
+
+# Do not ship build probes/trustcache artifacts.
+rm -rf "$runtime/payload/bin" "$runtime/payload/trustcache.txt"
+find "$stage" -type f \( -name .DS_Store -o -name '._*' \) -delete
+xattr -cr "$stage"
+
+installed_size="$(du -sk "$stage" | awk '{print $1}')"
+sed -i '' -e "s/^Description:/Installed-Size: $installed_size\\nDescription:/" "$stage/DEBIAN/control"
+dpkg-deb --build "$stage" "$release/VirtualMac_RootHide_${release_version}_${commit_hash}.deb" >/dev/null
+
+echo "$release/VirtualMac_RootHide_${release_version}_${commit_hash}.deb"
